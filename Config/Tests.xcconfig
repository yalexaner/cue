// unit-test-target settings; hosted in the app process
PRODUCT_BUNDLE_IDENTIFIER = dev.yachmenev.cueTests
TEST_HOST = $(BUILT_PRODUCTS_DIR)/cue.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/cue
BUNDLE_LOADER = $(TEST_HOST)
